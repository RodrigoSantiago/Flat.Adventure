#pragma kernel DefragmentBuffer

struct Move {
    uint srcOffset;
    uint dstOffset;
    uint length;
    uint cumulativeEnd;
};

StructuredBuffer<uint4> Src;
RWStructuredBuffer<uint4> Dst;
StructuredBuffer<Move> Moves;

uint moveCount;
uint totalLength;
uint groupsX;

[numthreads(256, 1, 1)]
void DefragmentBuffer(uint3 id : SV_DispatchThreadID) {
    uint threadIndex = id.x + id.y * groupsX * 256;
    uint index = threadIndex * 4;

    if (index >= totalLength)
        return;

    uint low = 0;
    uint high = moveCount;

    while (low < high) {
        uint middle = low + ((high - low) >> 1);

        if (index < Moves[middle].cumulativeEnd)
            high = middle;
        else
            low = middle + 1;
    }

    Move move = Moves[low];
    uint localIndex = index;

    if (low > 0)
        localIndex -= Moves[low - 1].cumulativeEnd;

    if (localIndex + 4 <= move.length) {
        uint sourceIndex = move.srcOffset + localIndex;
        uint destinationIndex = move.dstOffset + localIndex;

        Dst[destinationIndex + 0] = Src[sourceIndex + 0];
        Dst[destinationIndex + 1] = Src[sourceIndex + 1];
        Dst[destinationIndex + 2] = Src[sourceIndex + 2];
        Dst[destinationIndex + 3] = Src[sourceIndex + 3];
        return;
    }

    for (uint i = 0; i < 4; i++) {
        uint currentIndex = index + i;

        if (currentIndex >= totalLength)
            return;

        uint currentLow = low;

        if (i > 0) {
            currentLow = 0;
            currentIndex = index + i;

            uint currentHigh = moveCount;

            while (currentLow < currentHigh) {
                uint middle = currentLow + ((currentHigh - currentLow) >> 1);

                if (currentIndex < Moves[middle].cumulativeEnd)
                    currentHigh = middle;
                else
                    currentLow = middle + 1;
            }
        }

        Move currentMove = Moves[currentLow];

        uint currentLocalIndex = currentIndex;

        if (currentLow > 0)
            currentLocalIndex -= Moves[currentLow - 1].cumulativeEnd;

        Dst[currentMove.dstOffset + currentLocalIndex] =
            Src[currentMove.srcOffset + currentLocalIndex];
    }
}