#pragma kernel Generate
#pragma kernel Mipmaps

RWStructuredBuffer<uint> MapBuffer;
RWStructuredBuffer<uint> VoxelBuffer;

#define CHUNK_SIZE_DEN (16388 / 4)
#define CHUNK_SIZE_MAT (24580 / 4)
#define CHUNK_SIZE (CHUNK_SIZE_DEN + CHUNK_SIZE_MAT)

uint4 BufferStride;
float4 ChunkPos;
float4 IndexPos;

uint QuantizeDensity(float value) {
    if (value <= 0.00) return 0;
    if (value < 0.50) return min(4, (uint)round(value * 10.0));
    if (value <= 1.00) return 5 + clamp((int)round((value - 0.55) * 20.0), 0, 9);
    return 15;
}

static const float CubeDensity[] = {
    0.00, 0.10, 0.20, 0.30, 0.40,
    0.55, 0.60, 0.65, 0.70, 0.75,
    0.80, 0.85, 0.90, 0.95, 1.00, 2.00 // [Special Case]
};

static const uint CubeDensityUint[] = {
     0, 10, 20, 30, 40,
    55, 60, 65, 70, 75,
    80, 85, 90, 95, 100, 100
};

static const uint lodChunkIndexOffset[] = {0, 512, 576, 584}; 

void GetVoxelIndex(uint3 pos, uint lod, out uint localIndex, out uint chunkIndex) {
    const uint3 lPos = pos >> lod;
    localIndex =  (lPos.x & 31)
               + ((lPos.z & 31) << 5)
               + ((lPos.y & 31) << 10);
    
    chunkIndex = (lPos.x >> 5)
               + (lPos.z >> 5) * (8 >> lod)
               + (lPos.y >> 5) * (8 >> lod) * (8 >> lod)
               + lodChunkIndexOffset[lod];
}

void StoreDenByte(uint localIndex, uint chunkIndex, uint val) {
    const uint chunkAddress = CHUNK_SIZE * chunkIndex;
    const uint bitOffset = 8 + localIndex * 4;

    const uint address = chunkAddress + bitOffset / 32;
    const uint shift = bitOffset % 32;

    const uint clearMask = ~(0xFu << shift);
    const uint shiftedValue = (val & 0xFu) << shift;

    uint original_value;
    uint out_value = VoxelBuffer[address];

    do
    {
        original_value = out_value;
        uint replace_value = (original_value & clearMask) | shiftedValue;

        InterlockedCompareExchange(
            VoxelBuffer[address],
            original_value,
            replace_value,
            out_value
        );

    } while (original_value != out_value);
}

void StoreMatByte(uint localIndex, uint chunkIndex, uint val) {
    const uint chunkAddress = CHUNK_SIZE_DEN + CHUNK_SIZE * chunkIndex;
    const uint bitOffset = 8 + localIndex * 6;

    const uint address = chunkAddress + bitOffset / 32;
    const uint shift = bitOffset % 32;

    const uint maskedValue = val & 0x3Fu;

    if (shift <= 26) {
        const uint clearMask = ~(0x3Fu << shift);
        const uint shiftedValue = maskedValue << shift;

        uint original_value;
        uint out_value = VoxelBuffer[address];
        do
        {
            original_value = out_value;
            const uint replace_value = (original_value & clearMask) | shiftedValue;

            InterlockedCompareExchange(
                VoxelBuffer[address],
                original_value,
                replace_value,
                out_value
            );
        } while (original_value != out_value);
    } else {
        const uint firstBits = 32 - shift;
        const uint secondBits = 6 - firstBits;

        const uint firstMask = ((1u << firstBits) - 1u) << shift;
        const uint firstValue = (maskedValue & ((1u << firstBits) - 1u)) << shift;

        uint original_value;
        uint out_value = VoxelBuffer[address];
        do
        {
            original_value = out_value;
            const uint replace_value = (original_value & ~firstMask) | firstValue;

            InterlockedCompareExchange(
                VoxelBuffer[address],
                original_value,
                replace_value,
                out_value
            );
        } while (original_value != out_value);

        const uint secondMask = (1u << secondBits) - 1u;
        const uint secondValue = maskedValue >> firstBits;

        out_value = VoxelBuffer[address + 1];

        do
        {
            original_value = out_value;
            const uint replace_value = (original_value & ~secondMask) | secondValue;

            InterlockedCompareExchange(
                VoxelBuffer[address + 1],
                original_value,
                replace_value,
                out_value
            );
        } while (original_value != out_value);
    }
}
[numthreads(8, 8, 8)]
void Generate(uint3 id : SV_DispatchThreadID) {
    const uint3 idx = id + IndexPos.xyz;
    const uint3 pos = idx + (uint3)ChunkPos.xyz;
    
    uint localIndex0, chunkIndex0;
    GetVoxelIndex(idx, 0, localIndex0, chunkIndex0);
    
    float height = 500.0
             + sin(pos.x * 0.02) * 20.0
             + cos(pos.z * 0.02) * 20.0;

    float distance = height - pos.y;
    float density = 0.5 + distance;
    density = clamp(density, 0.0, 1.0);

    uint material = density > 0 ? 1 : 0;

    const uint densityQuantized = QuantizeDensity(density);
    StoreDenByte(localIndex0, chunkIndex0, densityQuantized);
    StoreMatByte(localIndex0, chunkIndex0, material);
}

uint2 ReadVoxel(const uint localIndex, const uint chunkIndex) {
    uint density;
    uint material;

    {
        const uint baseByteOffset = (CHUNK_SIZE * chunkIndex) * 4u + 1u;
        const uint bitOffset = (baseByteOffset * 8u) + (localIndex * 4u);
        
        const uint wordIndex = bitOffset / 32u; // ou (bitOffset >> 5u)
        const uint shift = bitOffset % 32u;     // ou (bitOffset & 31u)

        density = (VoxelBuffer[wordIndex] >> shift) & 15u; // 15u = 0xF (4 bits)
    }

    {
        const uint baseByteOffset = (CHUNK_SIZE * chunkIndex + CHUNK_SIZE_DEN) * 4u + 1u;
        const uint bitOffset = (baseByteOffset * 8u) + (localIndex * 6u);
        
        const uint wordIndex = bitOffset / 32u;
        const uint shift = bitOffset % 32u;

        uint packed = VoxelBuffer[wordIndex] >> shift;
        if (shift > 26u) {
            packed |= (VoxelBuffer[wordIndex + 1u] << (32u - shift));
        }

        material = packed & 63u; // 63u = 0x3F (6 bits)
    }

    return uint2(density, material);
}

uint2 ReadVoxelAt(int3 pos, uint lod) {
    uint localIndexLow, chunkIndexLow;
    GetVoxelIndex(pos, lod, localIndexLow, chunkIndexLow);
    return ReadVoxel(localIndexLow, chunkIndexLow);
}

[numthreads(8, 8, 8)]
void Mipmaps(uint3 id : SV_DispatchThreadID) {
    const uint lod = (uint)IndexPos.w;
    const uint3 idx = uint3(id.x % 32, id.y, id.z);
    const uint chunkLocal = id.x / 32;
    const uint chunkIndex = chunkLocal + lodChunkIndexOffset[lod];
    const uint localIndex = idx.x + idx.z * 32 + idx.y * 1024;

    const uint di = 8 >> lod;
    const uint di2 = di * di;
    const uint3 pos = uint3(chunkLocal % di, chunkLocal / di2, (chunkLocal % di2) / di) * (32 << lod) + (idx << lod);
    
    const int step = 1 << (lod - 1); 
    const int3 currentPos = pos;

    uint2 materials[8];
    int sample = 0;
    float totalDensity = 0.0f;
    [unroll] for (int z = 0; z < 2; z++) 
    [unroll] for (int y = 0; y < 2; y++) 
    [unroll] for (int x = 0; x < 2; x++) {
        const int3 offsetPos = currentPos + int3(x * step, y * step, z * step);
        const uint2 voxel = ReadVoxelAt(offsetPos, lod - 1);
        totalDensity += CubeDensity[voxel.x];
        materials[sample++] = uint2(voxel.y, CubeDensityUint[voxel.x]);
    }
    
    uint mat = materials[0].x;
    uint maxCount = 0;
    [unroll] for (uint i = 0; i < 8; i++) {
        uint count = 0;
        [unroll] for (uint j = 0; j < 8; j++) {
            count += (materials[i].x == materials[j].x) ? materials[i].y : 0;
        }
        if (count > maxCount) {
            maxCount = count;
            mat = materials[i].x;
        }
    }
    
    StoreDenByte(localIndex, chunkIndex, QuantizeDensity(totalDensity / 8.0));
    StoreMatByte(localIndex, chunkIndex, mat);
}