        },
        {
            "m_Id": "ae8bfe7bd84044e781f4e2e05cbb653c"
        }
    ],
    "synonyms": [
        "code",
        "HLSL"
    ],
    "m_Precision": 0,
    "m_PreviewExpanded": false,
    "m_DismissedVersion": 0,
    "m_PreviewMode": 0,
    "m_CustomColors": {
        "m_SerializableColors": []
    },
    "m_SourceType": 1,
    "m_FunctionName": "wireframe",
    "m_FunctionSource": "",
    "m_FunctionSourceUsePragmas": true,
    "m_FunctionBody": "float2 fw = fwidth(uv);\r\n\r\nfloat2 edge = min(uv, 1.0 - uv);\r\n\r\nfloat2 width = fw * thickness;\r\n\r\nstroke = (edge.x < width.x || edge.y < width.y) ? 1.0 : 0.0;"
}

